# Copy to .env and edit. Every setting below is optional and has a working
# default; a run with `--text keep` needs nothing here at all.
#
# Precedence: CLI flags > .env > the defaults in src/docaug/config.py.

# --- Paths -------------------------------------------------------------------
# Fonts scanned into the sampling bank. Defaults to the open-licensed set
# bundled inside the package. Lay your own out by category
# (<dir>/{sans,serif,handwriting,display,monospace}/*.ttf), run
# `docaug fonts scan --dir <dir>`, and point this at it.
# DOCAUG_FONTS_DIR=myfonts

# Real handwriting glyph bank. NO BANK SHIPS WITH THIS REPO -- glyph instances
# are cut from handwriting corpora whose licences are not ours to pass on.
# See docs/glyph-bank.md to build one. Required only for `--renderer glyph`.
# DOCAUG_GLYPH_BANK_DIR=assets/glyph_bank

# Content-addressed cache for LLM responses. Keeping this between runs means
# re-rendering a corpus with different typefaces costs nothing.
# DOCAUG_CACHE_DIR=.docaug-cache

# --- Determinism -------------------------------------------------------------
# Every page derives its RNG from this and its index, so a run reproduces
# exactly. Change it to get a different-looking corpus from the same sources.
# DOCAUG_SEED=20260626

# --- Ingestion ---------------------------------------------------------------
# Longest image side in pixels; larger pages are downscaled with their regions.
# DOCAUG_MAX_SIDE=2600

# --- Typeface sampling (per page) --------------------------------------------
# DOCAUG_HANDWRITING_PROB=0.10
# DOCAUG_HANDWRITING_MAX_REGIONS=25
# DOCAUG_BOLD_PROB=0.10
# DOCAUG_ITALIC_PROB=0.01
# DOCAUG_SLANT=0.15

# --- Handwriting-style warp --------------------------------------------------
# DOCAUG_AUGMENT_PROB=0.50
# DOCAUG_AUGMENT_MIN=0.5
# DOCAUG_AUGMENT_MAX=1.1
# DOCAUG_SUPERSAMPLE=3

# --- Rendering ---------------------------------------------------------------
# DOCAUG_LEADING=1.35
# DOCAUG_SIZE_SCALE=0.95
# DOCAUG_PAD_FRACTION=0.10
# DOCAUG_MIN_SIZE=6

# --- LLM ---------------------------------------------------------------------
# Needed only by `--text translate` and `--text synth`. Any OpenAI-compatible
# endpoint works: OpenRouter, vLLM, Ollama, LM Studio, or the OpenAI API.
# DOCAUG_LLM_BASE_URL=https://openrouter.ai/api/v1
# DOCAUG_LLM_API_KEY=
# DOCAUG_LLM_MODEL=google/gemini-2.5-flash
# DOCAUG_LLM_TIMEOUT=120
# DOCAUG_LLM_RETRIES=4
# Regions translated in parallel. One request per region, never a batch -- see
# the note in src/docaug/text/llm.py for why.
# DOCAUG_LLM_CONCURRENCY=8
